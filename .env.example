# PostgreSQL kapcsolat (Vercel Dashboard → Storage → az adatbázisod → .env.local fül,
# a POSTGRES_URL / DATABASE_URL értéke). Helyi példa:
DATABASE_URL=postgres://postgres:jelszo@localhost:5432/budget

# Véletlen titok a munkamenet-cookie aláírásához (éles környezetben kötelező):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcionális: SSL kikényszerítése/tiltása (alapból: helyi címen ki, távolin be)
# DATABASE_SSL=true

# Opcionális: időzóna a napi/heti keretekhez és statisztikához
# APP_TIMEZONE=Europe/Budapest

# Opcionális: API port (alapértelmezés: 4000)
# PORT=4000
